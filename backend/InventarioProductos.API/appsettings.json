{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emisor": "InventarioProductos.API",
    "Audiencia": "InventarioProductos.Web",
    "MinutosExpiracion": 60
  },
  "Cors": {
    "OrigenesPermitidos": [ "http://localhost:4200" ]
  }
}