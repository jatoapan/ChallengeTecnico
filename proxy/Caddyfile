# Caddy es la puerta de entrada: recibe HTTP/HTTPS, obtiene y renueva solo el certificado de
# Let's Encrypt para el dominio y reenvía todo a Nginx (que sirve el front y reenvía /api a la API).
# DOMINIO viene del .env. Con "localhost" usa un certificado local de prueba (el navegador avisará).
{$DOMINIO:localhost} {
	encode zstd gzip

	header {
		# Obliga al navegador a usar HTTPS en las visitas siguientes
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy web:80
}
