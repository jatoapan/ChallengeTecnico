# Copia este archivo a ".env" y completa los valores (o genera uno con: ./scripts/crear-env.sh http://TU_IP).
# El archivo .env NO se sube a Git. Aquí no se escribe ningún valor real.

# Contraseña del usuario "sa" de SQL Server (mínimo 8 caracteres con mayúscula, minúscula, número y símbolo)
MSSQL_SA_PASSWORD=

# Clave con la que la API firma los tokens JWT (mínimo 32 caracteres, aleatoria)
JWT_CLAVE=

# Dirección pública desde la que se abre el sitio, sin barra final (la API la permite por CORS)
ORIGEN_PUBLICO=http://localhost

# true: publica la documentación Swagger en /swagger (útil en la revisión); false: la oculta
SWAGGER_HABILITADO=false

# Puerto público del sitio y puerto local de SQL Server (solo accesible desde la propia máquina)
PUERTO_WEB=80
PUERTO_SQL=1433
